DATABASE_URL=sqlite:///./pharmveda.db
UPLOAD_DIR=./uploads
CHROMA_DIR=./chroma_data

JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ollama | hosted
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Only used when LLM_PROVIDER=hosted. Get a free-tier key from Google AI Studio (Gemini) or Groq.
HOSTED_LLM_API_KEY=
HOSTED_LLM_PROVIDER=gemini
HOSTED_LLM_MODEL=gemini-1.5-flash

# Production only (leave as-is for local dev):
# Comma-separated origins allowed to call this API, e.g. https://pharmveda.up.railway.app
FRONTEND_ORIGINS=http://localhost:5173
# Set to true once served over HTTPS - required for cross-origin login cookies to work
COOKIE_SECURE=false
